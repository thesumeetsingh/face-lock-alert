SECRET_KEY=replace-with-a-random-secret
FACE_CAPTURE_COUNT=15
FACE_CONFIDENCE_THRESHOLD=70

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password
DB_NAME=face_lock_alert

# Email alerts - use a Gmail App Password, not your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ALERT_EMAIL=your-sender@gmail.com
ALERT_EMAIL_PASSWORD=your-16-character-gmail-app-password

# Twilio SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
